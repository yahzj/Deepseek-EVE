#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# 提交前闸门（**2026-09-27 船长批**）
#
# 为什么要有它：仓库里的规则与体检脚本**只能报错，拦不住我提交** —— 2026-09-27 就发生过
# 「只跑了两个测试文件就提交，全量 core 当时有 3 条红」（提交 629fb00f，后在 70117f78 补绿）。
# 规则靠我记住就会漏；钩子让"漏了也提交不进去"。
#
# 三档（船长 2026-09-27 定的分级）：
#   ❌ 阻断   —— 闸门未过 ⇒ 拒绝提交
#   ⚠️ 需裁决 —— 命中"我判断不了、要船长定"的事 ⇒ **也拒绝提交**，先报告再继续
#   ℹ️ 提示   —— 只打印，不打断（**2026-10-02 起用于「模块范围读数」**，见文末 C 类）
#
# ⚠ 承诺：不拿 `git commit --no-verify` 绕过；万一必须绕过，在汇报里单独说明理由。
# ⚠ 全量用例（4~6 分钟）不进本钩子，仍在**推送前**手工跑。
# ─────────────────────────────────────────────────────────────────────────────
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

staged=$(git diff --cached --name-only)
if [ -z "$staged" ]; then exit 0; fi

ask=0

# ── ⚠️ 需裁决（B 类，只收"机器能检测"的）──────────────────────────────────
# B-2 要碰玩家数据/存档（读档、迁移、补发、改档）
if printf '%s\n' "$staged" | grep -qE '(^|/)save\.ts$|test-saves|ironman'; then
  echo "⚠️ 需裁决：本次提交触及 **存档 / 玩家数据** 相关文件："
  printf '%s\n' "$staged" | grep -E 'save\.ts|test-saves|ironman' | sed 's/^/      /'
  echo "      ⇒ 停下来向船长报告（改了哪几处、为什么改、会不会影响玩家档），等他回复再继续。"
  ask=1
fi
# B-3 要动已冻结/已标定的东西（封存工具、标定过的数值表）
# ⚠ **2026-09-27 船长批：`docs/archive/` 已移出本档** —— 因为 `npm run docs:seal` 是它的
#   **唯一正常写入者**（每次正常归档都会写封存卷），留着这条会让"每次归档都被拦"。
#   改由规则约束：**封存卷只允许 `docs:seal` 写，手改才算违规**。
#   保留的两项仍需裁决：改封存工具本身、改 balance.ts 的标定数值。
if printf '%s\n' "$staged" | grep -qE 'tools/docs-seal\.ts|packages/core/src/balance\.ts'; then
  echo "⚠️ 需裁决：本次提交触及 **已冻结 / 已标定** 的内容："
  printf '%s\n' "$staged" | grep -E 'docs-seal\.ts|balance\.ts' | sed 's/^/      /'
  echo "      ⇒ 封存工具是冻结件的唯一写入者；balance.ts 的数值多为已标定关系。先向船长报告再继续。"
  ask=1
fi

# ── ❌ 阻断（A 类）：快四样（合计约 30 秒）──────────────────────────────────
fail=0
for c in typecheck content:check l10n:check ui:rot-check; do
  printf '── %-14s ' "$c"
  if npm run --silent "$c" >/dev/null 2>&1; then
    echo "✅"
  else
    echo "❌  ← 手动跑「npm run $c」看详情"
    fail=1
  fi
done

# ── ℹ️ 提示（C 类）：模块范围读数（**约定 §十八 · 船长 2026-10-02 令**）──────
# 为什么只提示、不阻断：§十八 要求「跨模块先申请」，但**船长已批准的跨域必须照样能提交**
# （例：一号的模块化重构整批跨十几个域，那是他点头过的）⇒ 机器只报读数，申请由我自己做。
# ⚠ 读数里出现「未归类」也是提示：那表示域表要补（工具 = `tools/domain-scope-check.ts`）。
npm run --silent scope:check -- --staged 2>/dev/null || true
echo ""
if [ "$fail" != 0 ]; then
  echo "❌ 闸门未过 ⇒ 本次提交被拒绝（修好再提交）。"
  exit 1
fi
if [ "$ask" != 0 ]; then
  echo "⚠️ 有需裁决项 ⇒ 本次提交被拒绝：先向船长报告并等回复。"
  echo "   （确认可以继续后，再提交即可；本钩子只负责把你叫住。）"
  exit 1
fi
echo "✅ 提交前闸门全绿"
exit 0