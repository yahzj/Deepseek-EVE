{
  "name": "whale-eve-idle",
  "version": "0.1.0",
  "private": true,
  "description": "大鲸鱼-深空放置 —— 以 EVE 星战前夜为蓝本的文字挂机游戏（单机起步，架构预留升级在线）",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @whale/desktop",
    "build": "npm run build -w @whale/desktop",
    "pack": "npm run pack -w @whale/desktop",
    "test": "npm run test -w @whale/core",
    "typecheck": "npm run typecheck -w @whale/core && npm run typecheck -w @whale/data && npm run typecheck -w @whale/ui && npm run typecheck -w @whale/desktop",
    "balance": "tsx tools/balance-check.ts",
    "salvage:econ": "tsx tools/salvage-econ.ts",
    "content:check": "tsx tools/content-check.ts",
    "faction:audit": "tsx tools/faction-audit.ts",
    "content:export": "tsx tools/content-export.ts",
    "content:import": "tsx tools/content-import.ts",
    "battle:calibrate": "tsx tools/battle-calibrate.ts",
    "battle:drone-vs-gun": "tsx tools/drone-vs-gun.ts",
    "battle:hit-profile": "tsx tools/hit-profile.ts",
    "battle:pd-tune": "tsx tools/pd-tune.ts",
    "battle:pd-vs-drone": "tsx tools/pd-vs-foe-drone.ts",
    "battle:mixed-review": "tsx tools/mixed-damage-review.ts",
    "bounty:econ": "tsx tools/bounty-econ.ts",
    "price:audit": "tsx tools/price-audit.ts",
    "liquidity:audit": "tsx tools/liquidity-audit.ts",
    "manufacture:econ": "tsx tools/manufacture-econ.ts"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "tsx": "^4.23.13"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true
  }
}
